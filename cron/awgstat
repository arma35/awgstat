SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# AWGStat — system crontab (/etc/cron.d/awgstat), not user crontab
# One lock protects collection → ONLINE publication from overlap and races.
* * * * * root /opt/wgstats/awgstat-cycle.sh >/dev/null 2>&1
# awgstat-cycle.sh forces "Today" at 00:01 in REPORT_TZ.
# Daily backup check at 03:00 — backup.sh no-ops until BACKUP_DAYS elapsed
0 3 * * * root /opt/wgstats/backup.sh >/dev/null 2>&1
