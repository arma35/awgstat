########################################
# AWGStat configuration
########################################

VERSION="1.1.2"

# Docker container with AmneziaWG
CONTAINER="amnezia-awg2"

# WireGuard interface inside container
WG_INTERFACE="awg0"

# Project directory on host
WORKDIR="/opt/wgstats"

# Data files
HISTORY="${WORKDIR}/history.csv"
LASTDB="${WORKDIR}/last.db"
NAMES="${WORKDIR}/names.map"
CHANGED="${WORKDIR}/.changed"

# Web output (served by your existing web server)
WEBROOT="/var/www/html-20180/wgstats"

# History retention
RETENTION_DAYS=365

# Backup period in days (backup.sh / cron at 03:00)
BACKUP_DAYS=7
BACKUP_DIR="${WORKDIR}/backups"
LAST_BACKUP="${WORKDIR}/.last_backup"

# Page title
TITLE="AWGStat"
