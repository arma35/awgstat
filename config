########################################
# AWGStat configuration
########################################

VERSION="2.3.0"

# Docker container with AmneziaWG
CONTAINER="amnezia-awg2"

# WireGuard interface inside container
WG_INTERFACE="awg0"

# Amnezia client metadata inside the container. When enabled, AWGStat imports
# clientId -> clientName for peers that are not yet present in names.map.
AUTO_DISCOVER_NAMES=1
AMNEZIA_CLIENTS_TABLE="/opt/amnezia/awg/clientsTable"

# Project directory on host
WORKDIR="/opt/wgstats"

# Data files
HISTORY="${WORKDIR}/history.csv"
LASTDB="${WORKDIR}/last.db"
NAMES="${WORKDIR}/names.map"
CHANGED="${WORKDIR}/.changed"
ONLINE_STATE="${WORKDIR}/online.csv"

# Web output (served by your existing web server)
WEBROOT="/var/www/html-20180/wgstats"

# History retention
RETENTION_DAYS=365

# Timezone for "Today" / midnight HTML rebuild (IANA name, e.g. Europe/Moscow = UTC+3)
REPORT_TZ="Europe/Moscow"

# Number of classic SARG file-tree periods to publish (0 = all retained history)
DAILY_REPORTS=31
WEEKLY_REPORTS=12
MONTHLY_REPORTS=12

# Maximum raw traffic intervals on each user detail page (0 = hide)
DETAIL_ROWS=200

# ONLINE report: summary/ranking window, activity/freshness, browser refresh
ONLINE_WINDOW_MINUTES=60
ONLINE_ACTIVE_MINUTES=3
ONLINE_STALE_MINUTES=3
ONLINE_REFRESH_SECONDS=60

# Backup period in days (backup.sh / cron at 03:00)
BACKUP_DAYS=7
BACKUP_DIR="${WORKDIR}/backups"
LAST_BACKUP="${WORKDIR}/.last_backup"

# Page title
TITLE="AWGStat"
